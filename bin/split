#!/usr/bin/env bash
# Pushes each component as a read-only repository (git subtree split) and, when a tag is given,
# tags the split commit with it. Usage: bin/split [vX.Y.Z]
set -euo pipefail
cd "$(dirname "$0")/.."
TAG="${1:-}"
declare -A COMPONENTS=(
  [container]=src/Container
  [router]=src/Routing
  [http]=src/Http
  [validation]=src/Validation
)
for name in "${!COMPONENTS[@]}"; do
  prefix="${COMPONENTS[$name]}"
  remote="https://github.com/AloneCoder/keel-${name}.git"
  echo "== keel/${name} (${prefix}) -> ${remote}"
  sha=$(git subtree split --prefix="$prefix" 2>/dev/null)
  git push --force "$remote" "${sha}:refs/heads/main"
  if [ -n "$TAG" ]; then
    git push --force "$remote" "${sha}:refs/tags/${TAG}"
  fi
done
