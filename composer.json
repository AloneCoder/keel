{
    "name": "keel/framework",
    "description": "Worker-first PHP micro-framework: PSR stack, attribute routing, compiled container.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/clock": "^1.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "spiral/roadrunner-http": "^4.2",
        "symfony/console": "^7.3|^8.0"
    },
    "suggest": {
        "symfony/console": "Console runtime and keel:* commands (any 7.3+ or 8.x)",
        "monolog/monolog": "PSR-3 logger implementation",
        "spiral/roadrunner-http": "RoadRunner runtime adapter"
    },
    "autoload": {
        "psr-4": {
            "Keel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keel\\Tests\\": "tests/",
            "Keel\\Examples\\Hello\\": "examples/hello/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
