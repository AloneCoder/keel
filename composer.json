{
    "name": "keel/framework",
    "description": "Worker-first PHP micro-framework: PSR stack, attribute routing, compiled container.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "doctrine/dbal": "^4.2",
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.35.8",
        "latte/latte": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "spiral/roadrunner-http": "^4.2",
        "symfony/console": "^7.3|^8.0",
        "twig/twig": "^3.15"
    },
    "suggest": {
        "symfony/console": "Console runtime and keel:* commands (any 7.3+ or 8.x)",
        "monolog/monolog": "PSR-3 logger implementation",
        "spiral/roadrunner-http": "RoadRunner runtime adapter"
    },
    "autoload": {
        "psr-4": {
            "Keel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keel\\Tests\\": "tests/",
            "Keel\\Examples\\Hello\\": "examples/hello/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "split": "bin/split",
        "infection": "infection --threads=max --show-mutations"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "replace": {
        "keel/container": "self.version",
        "keel/router": "self.version",
        "keel/http": "self.version",
        "keel/validation": "self.version"
    }
}
