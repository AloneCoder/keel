{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src/Container", "src/Routing", "src/Auth", "src/RateLimit", "src/Health", "src/Metrics"]
    },
    "timeout": 20,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection-summary.log"
    },
    "mutators": {
        "@default": true,
        // String building (messages, generated code) and integer tweaks (indentation, chunk sizes,
        // permissions) mutate formatting, not behaviour; they only add noise here.
        "Concat": false,
        "ConcatOperandRemoval": false,
        "IncrementInteger": false,
        "DecrementInteger": false
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 80,
    "minCoveredMsi": 80
}
