{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src/Container", "src/Routing"]
    },
    "timeout": 20,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 80,
    "minCoveredMsi": 85
}
